<?xml version='1.0' encoding='utf-8'?>
<configuration>
	<connectionStrings>
		<add name="Ferreteria"
		 providerName="System.Data.ProviderName"
		 connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=Ferreteria;Integrated Security=True;Connect Timeout=30;Encrypt=True;Trust Server Certificate=False;Application Intent=ReadWrite;Multi Subnet Failover=False;Command Timeout=30" />
	</connectionStrings>
</configuration>